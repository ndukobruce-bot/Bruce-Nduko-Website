+++ b/src/app/robots.ts
@@ -0,0 +1,10 @@
+import type { MetadataRoute } from "next";
+import { links } from "@/content/links";
+
+export default function robots(): MetadataRoute.Robots {
+  return {
+    rules: { userAgent: "*", allow: "/", disallow: "/api/" },
+    sitemap: `${links.siteUrl}/sitemap.xml`,
+    host: links.siteUrl,
+  };
+}
diff --git a/src/app/sitemap.ts b/src/app/sitemap.ts
new file mode 100644
index 0000000..b39952b
--- /dev/null
+++ b/src/app/sitemap.ts
@@ -0,0 +1,23 @@
+import type { MetadataRoute } from "next";
+import { links } from "@/content/links";
+import { projects } from "@/content/projects";
+
+const pages = ["", "/about", "/projects", "/certifications", "/now", "/principles", "/uses"];
+
+export default function sitemap(): MetadataRoute.Sitemap {
+  const now = new Date();
+  return [
+    ...pages.map((path) => ({
+      url: `${links.siteUrl}${path}`,
+      lastModified: now,
+      changeFrequency: "monthly" as const,
+      priority: path === "" ? 1 : 0.7,
+    })),
+    ...projects.map((p) => ({
+      url: `${links.siteUrl}/projects/${p.slug}`,
+      lastModified: now,
+      changeFrequency: "monthly" as const,
+      priority: 0.6,
+    })),
+  ];
+}
diff --git a/src/components/site-footer.tsx b/src/components/site-footer.tsx
new file mode 100644
index 0000000..364f723
--- /dev/null
+++ b/src/components/site-footer.tsx
@@ -0,0 +1,46 @@
+import { profile } from "@/content/profile";
+import { links } from "@/content/links";
+
+const PLAY_STORE =
+  "https://play.google.com/store/apps/details?id=com.leveragex.leveragex";
+
+export function SiteFooter() {
+  const profiles = [
+    { label: "GitHub", href: links.social.github },
+    { label: "LinkedIn", href: links.social.linkedin },
+    { label: "X", href: links.social.x },
+    { label: "Tija Labs", href: "https://tijalabs.com" },
+    { label: "LeverageX", href: PLAY_STORE },
+  ].filter((l) => l.href);
+
+  return (
+    <footer className="relative z-10 border-t border-border">
+      <div className="mx-auto flex max-w-4xl flex-col gap-4 px-6 py-10 text-sm text-muted sm:flex-row sm:items-center sm:justify-between">
+        <p>
+          &copy; {new Date().getFullYear()} {profile.name} — {profile.headline}
+        </p>
+        <nav aria-label="Find Bruce Nduko online">
+          <ul className="flex flex-wrap gap-x-5 gap-y-2">
+            {profiles.map((l) => (
+              <li key={l.label}>
+                <a
+                  href={l.href}
+                  target="_blank"
+                  rel="me noopener noreferrer"
+                  className="hover:text-accent"
+                >
+                  {l.label}
+                </a>
+              </li>
+            ))}
+            <li>
+              <a href={`mailto:${profile.contact.email}`} className="hover:text-accent">
+                Email
+              </a>
+            </li>
+          </ul>
+        </nav>
+      </div>
+    </footer>
+  );
+}
